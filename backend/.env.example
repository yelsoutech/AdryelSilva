# Database (Supabase Postgres pooler — use the connection string from your Supabase project)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marketplace_intelligence

# Supabase (for JWT verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Marketplace Intelligence
DEBUG=true
ENVIRONMENT=development

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# Mercado Livre (to be configured when integration is built)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/mercadolivre/callback

# Worker
WORKER_POLL_INTERVAL=5
WORKER_MAX_CONCURRENT=10
